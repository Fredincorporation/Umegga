# Vite exposes these values in the browser; use the project's public anon key.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=

# Public frontend endpoint
VITE_AGENT_CHAT_ENDPOINT=http://localhost:3001/api/agent-chat

# Backend-only AI provider settings
AI_API_KEY=
AI_MODEL=openai/gpt-oss-20b
AI_API_URL=https://api.groq.com/openai/v1/chat/completions
# Render supplies PORT automatically; use this only for local development.
AGENT_CHAT_PORT=3001
