# Vite exposes these values in the browser; use the project's public anon key.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=

# Public frontend endpoint (set to your deployed worker URL in production, e.g. https://umegga-agent-chat.<account>.workers.dev/api/agent-chat)
VITE_AGENT_CHAT_ENDPOINT=/api/agent-chat

# Cloudflare Worker local dev secrets (copied from .env, gitignored)
AI_API_KEY=
AI_MODEL=openai/gpt-oss-20b
AI_API_URL=https://api.groq.com/openai/v1/chat/completions
# Cloudflare Pages project hosting game assets (set your own deployed URL)
VITE_ASSET_BASE_URL=
